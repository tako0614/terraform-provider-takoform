{
  "apiVersion": "forms.takoform.com/v1alpha1",
  "kind": "PrivateNetwork",
  "definitionVersion": "1.0.0",
  "title": "Private Network",
  "description": "Portable private address space that other Resources can attach to.",
  "status": "standard",
  "desiredSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "addressSpace": {
        "pattern": "^(?:(?:(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])/(?:[0-9]|[12][0-9]|3[0-2])|(?:(?:[0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,7}:|(?:[0-9A-Fa-f]{1,4}:){1,6}:[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4}:){1,5}(?::[0-9A-Fa-f]{1,4}){1,2}|(?:[0-9A-Fa-f]{1,4}:){1,4}(?::[0-9A-Fa-f]{1,4}){1,3}|(?:[0-9A-Fa-f]{1,4}:){1,3}(?::[0-9A-Fa-f]{1,4}){1,4}|(?:[0-9A-Fa-f]{1,4}:){1,2}(?::[0-9A-Fa-f]{1,4}){1,5}|[0-9A-Fa-f]{1,4}:(?:(?::[0-9A-Fa-f]{1,4}){1,6})|:(?:(?::[0-9A-Fa-f]{1,4}){1,7}|:))/(?:[0-9]|[1-9][0-9]|1[01][0-9]|12[0-8]))$",
        "type": "string"
      },
      "name": {
        "maxLength": 63,
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9-]{0,62}$",
        "type": "string"
      },
      "publicEgress": {
        "type": "boolean"
      }
    },
    "required": [
      "addressSpace",
      "name"
    ],
    "type": "object"
  },
  "observedSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "driftedFields": {
        "items": {
          "pattern": "^(?:/(?:[^~/]|~0|~1)*)+$",
          "type": "string"
        },
        "type": "array",
        "uniqueItems": true
      },
      "generation": {
        "maximum": 9223372036854775807,
        "minimum": 1,
        "type": "integer"
      },
      "id": {
        "pattern": "^PrivateNetwork/[a-z][a-z0-9-]{0,62}$",
        "type": "string"
      },
      "imported": {
        "type": "boolean"
      },
      "portability": {
        "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "ready": {
        "type": "boolean"
      }
    },
    "required": [
      "driftedFields",
      "generation",
      "id",
      "imported",
      "portability",
      "ready"
    ],
    "type": "object"
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "generation": {
        "maximum": 9223372036854775807,
        "minimum": 1,
        "type": "integer"
      },
      "id": {
        "pattern": "^PrivateNetwork/[a-z][a-z0-9-]{0,62}$",
        "type": "string"
      },
      "kind": {
        "const": "PrivateNetwork",
        "type": "string"
      },
      "name": {
        "maxLength": 63,
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9-]{0,62}$",
        "type": "string"
      },
      "portability": {
        "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      }
    },
    "required": [
      "generation",
      "id",
      "kind",
      "name",
      "portability"
    ],
    "type": "object"
  },
  "immutableFields": [
    "/addressSpace",
    "/name"
  ],
  "lifecycleCapabilities": [
    "create",
    "read",
    "update",
    "delete",
    "import",
    "observe",
    "refresh",
    "drift"
  ],
  "interfaces": [
    {
      "name": "network.attach",
      "version": "1",
      "description": "Portable private network attachment operations.",
      "required": true,
      "document": {
        "operations": [
          "attach",
          "detach"
        ]
      },
      "documentSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "operations": {
            "items": {
              "enum": [
                "attach",
                "detach"
              ],
              "type": "string"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "operations"
        ],
        "type": "object"
      },
      "inputs": [
        {
          "name": "resource",
          "source": "output",
          "pointer": "/id"
        },
        {
          "name": "name",
          "source": "output",
          "pointer": "/name"
        }
      ]
    }
  ],
  "conformanceFixtures": [
    {
      "name": "canonical",
      "desiredPath": "fixtures/desired.json",
      "observedPath": "fixtures/observed.json",
      "outputPath": "fixtures/output.json"
    }
  ],
  "negativeConformanceFixtures": [
    {
      "name": "reject-missing-name",
      "stage": "desired",
      "inputPath": "fixtures/negative-missing-name.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-missing-address_space",
      "stage": "desired",
      "inputPath": "fixtures/negative-missing-address_space.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-address_space",
      "stage": "desired",
      "inputPath": "fixtures/negative-address_space.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-observed-foreign-kind-id",
      "stage": "observed",
      "inputPath": "fixtures/negative-observed-foreign-kind-id.json",
      "expectedFailure": "schema_validation_failed"
    }
  ]
}
