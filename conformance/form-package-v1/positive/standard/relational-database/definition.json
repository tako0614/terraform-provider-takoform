{
  "apiVersion": "forms.takoform.com/v1alpha1",
  "kind": "RelationalDatabase",
  "definitionVersion": "1.0.0",
  "title": "Relational Database",
  "description": "Portable relational database addressed through an open engine capability token.",
  "status": "standard",
  "desiredSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "databaseName": {
        "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "engine": {
        "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "engineVersion": {
        "minLength": 1,
        "type": "string"
      },
      "highAvailability": {
        "type": "boolean"
      },
      "name": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": ".*\\S.*",
        "type": "string"
      },
      "sizeClass": {
        "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "storageGib": {
        "minimum": 1,
        "type": "integer"
      }
    },
    "required": [
      "engine",
      "name"
    ],
    "type": "object"
  },
  "observedSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "driftedFields": {
        "items": {
          "pattern": "^(?:/(?:[^~/]|~0|~1)*)+$",
          "type": "string"
        },
        "type": "array",
        "uniqueItems": true
      },
      "generation": {
        "minimum": 1,
        "type": "integer"
      },
      "id": {
        "minLength": 1,
        "type": "string"
      },
      "imported": {
        "type": "boolean"
      },
      "portability": {
        "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "ready": {
        "type": "boolean"
      }
    },
    "required": [
      "driftedFields",
      "generation",
      "id",
      "imported",
      "portability",
      "ready"
    ],
    "type": "object"
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "engine": {
        "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "generation": {
        "minimum": 1,
        "type": "integer"
      },
      "id": {
        "minLength": 1,
        "type": "string"
      },
      "kind": {
        "const": "RelationalDatabase",
        "type": "string"
      },
      "name": {
        "minLength": 1,
        "type": "string"
      },
      "portability": {
        "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      }
    },
    "required": [
      "engine",
      "generation",
      "id",
      "kind",
      "name",
      "portability"
    ],
    "type": "object"
  },
  "immutableFields": [
    "/databaseName",
    "/engine",
    "/name"
  ],
  "lifecycleCapabilities": [
    "create",
    "read",
    "update",
    "delete",
    "import",
    "observe",
    "refresh",
    "drift"
  ],
  "interfaces": [
    {
      "name": "sql.query",
      "version": "1",
      "description": "Portable SQL query and transaction operations.",
      "required": true,
      "document": {
        "operations": [
          "execute",
          "query",
          "transaction"
        ]
      },
      "documentSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "operations": {
            "items": {
              "enum": [
                "execute",
                "query",
                "transaction"
              ],
              "type": "string"
            },
            "maxItems": 3,
            "minItems": 3,
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "operations"
        ],
        "type": "object"
      },
      "inputs": [
        {
          "name": "resource",
          "source": "output",
          "pointer": "/id"
        },
        {
          "name": "name",
          "source": "output",
          "pointer": "/name"
        },
        {
          "name": "engine",
          "source": "output",
          "pointer": "/engine"
        }
      ]
    }
  ],
  "conformanceFixtures": [
    {
      "name": "canonical",
      "desiredPath": "fixtures/desired.json",
      "observedPath": "fixtures/observed.json",
      "outputPath": "fixtures/output.json"
    }
  ],
  "negativeConformanceFixtures": [
    {
      "name": "reject-engine",
      "stage": "desired",
      "inputPath": "fixtures/negative-engine.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-storage_gib",
      "stage": "desired",
      "inputPath": "fixtures/negative-storage_gib.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-size_class",
      "stage": "desired",
      "inputPath": "fixtures/negative-size_class.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-database_name",
      "stage": "desired",
      "inputPath": "fixtures/negative-database_name.json",
      "expectedFailure": "schema_validation_failed"
    }
  ]
}
