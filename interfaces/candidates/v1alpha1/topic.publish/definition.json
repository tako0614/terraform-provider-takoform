{
  "apiVersion": "interfaces.takoform.com/v1alpha1",
  "kind": "InterfaceDefinition",
  "name": "topic.publish",
  "version": "1.0.0",
  "title": "Fanout topic publish",
  "description": "Publish one declarative message to a Topic. An accepted publish is delivered at least once to every matching subscription present at acceptance; the Topic retains and replays nothing and does not guarantee ordering.",
  "operations": [
    {
      "name": "publish",
      "description": "Accept one message for fanout. Acceptance is durable only as the fanout decision; a subscription's independent delivery may retry or dead-letter later.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "attributes": {
            "additionalProperties": {
              "maxLength": 262144,
              "pattern": "^[\\s\\S]*$",
              "type": "string"
            },
            "maxProperties": 10,
            "propertyNames": {
              "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$",
              "type": "string"
            },
            "type": "object"
          },
          "body": {
            "oneOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "data": {
                    "maxLength": 262144,
                    "pattern": "^[\\s\\S]*$",
                    "type": "string"
                  },
                  "encoding": {
                    "const": "utf8",
                    "type": "string"
                  }
                },
                "required": [
                  "encoding",
                  "data"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "data": {
                    "maxLength": 349528,
                    "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
                    "type": "string"
                  },
                  "encoding": {
                    "const": "base64",
                    "type": "string"
                  }
                },
                "required": [
                  "encoding",
                  "data"
                ],
                "type": "object"
              }
            ]
          }
        },
        "required": [
          "body",
          "attributes"
        ],
        "type": "object"
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "errors": [
        "invalid_body",
        "message_too_large",
        "backend_unavailable"
      ]
    }
  ],
  "semantics": {
    "consistency": "eventual",
    "delivery": "at_least_once",
    "ordering": "none"
  },
  "limits": {
    "maxAttributes": 10,
    "maxMessageBytes": 262144
  },
  "fixtures": [
    {
      "name": "publish-accepted",
      "steps": [
        {
          "operation": "publish",
          "input": {
            "attributes": {
              "eventType": "order.created"
            },
            "body": {
              "data": "order.created",
              "encoding": "utf8"
            }
          }
        }
      ]
    },
    {
      "name": "invalid-body-rejected",
      "steps": [
        {
          "operation": "publish",
          "input": {
            "body": {
              "data": "x",
              "encoding": "unknown"
            }
          },
          "expectedError": "invalid_body"
        }
      ]
    }
  ]
}
