  "fixtures": [
    {
      "name": "create-insert-select",
      "steps": [
        {
          "operation": "execute",
          "input": {
            "sql": "CREATE TABLE notes (id INTEGER PRIMARY KEY, body TEXT NOT NULL)"
          },
          "expected": {
            "rows": [],
            "rowsWritten": 0
          }
        },
        {
          "operation": "execute",
          "input": {
            "params": [
              {
                "type": "text",
                "value": "first note"
              }
            ],
            "sql": "INSERT INTO notes (body) VALUES (?1)"
          },
          "expected": {
            "lastInsertRowId": "1",
            "rowsWritten": 1
          }
        },
        {
          "operation": "query",
          "input": {
            "sql": "SELECT body FROM notes ORDER BY id"
          },
          "expected": {
            "rows": [
              {
                "body": {
                  "type": "text",
                  "value": "first note"
                }
              }
            ],
            "rowsWritten": 0
          }
        }
      ]
    },
    {
      "name": "a-64-bit-integer-round-trips-losslessly",
      "steps": [
        {
          "operation": "execute",
          "input": {
            "sql": "CREATE TABLE counters (v INTEGER NOT NULL)"
          }
        },
        {
          "operation": "execute",
          "input": {
            "params": [
              {
                "type": "integer",
                "value": "9223372036854775807"
              }
            ],
            "sql": "INSERT INTO counters (v) VALUES (?1)"
          },
          "expected": {
            "rowsWritten": 1
          }
        },
        {
          "operation": "query",
          "input": {
            "sql": "SELECT v FROM counters"
          },
          "expected": {
            "rows": [
              {
                "v": {
                  "type": "integer",
                  "value": "9223372036854775807"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "name": "a-blob-round-trips-losslessly",
      "steps": [
        {
          "operation": "execute",
          "input": {
            "sql": "CREATE TABLE payloads (v BLOB NOT NULL)"
          }
        },
        {
          "operation": "execute",
          "input": {
            "params": [
              {
                "base64": "AAECg/8=",
                "type": "blob"
              }
            ],
            "sql": "INSERT INTO payloads (v) VALUES (?1)"
          },
          "expected": {
            "rowsWritten": 1
          }
        },
        {
          "operation": "query",
          "input": {
            "sql": "SELECT v FROM payloads"
          },
          "expected": {
            "rows": [
              {
                "v": {
                  "base64": "AAECg/8=",
                  "type": "blob"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "name": "null-and-real-keep-their-storage-classes",
      "steps": [
        {
          "operation": "execute",
          "input": {
            "sql": "CREATE TABLE readings (a REAL, b TEXT)"
          }
        },
        {
          "operation": "execute",
          "input": {
            "params": [
              {
                "type": "real",
                "value": 1.5
              },
              {
                "type": "null"
              }
            ],
            "sql": "INSERT INTO readings (a, b) VALUES (?1, ?2)"
          },
          "expected": {
            "rowsWritten": 1
          }
        },
        {
          "operation": "query",
          "input": {
            "sql": "SELECT a, b FROM readings"
          },
          "expected": {
            "rows": [
              {
                "a": {
                  "type": "real",
                  "value": 1.5
                },
                "b": {
                  "type": "null"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "name": "a-transaction-reports-one-result-per-statement",
      "steps": [
        {
          "operation": "transaction",
          "input": {
            "statements": [
              {
                "sql": "CREATE TABLE events (id INTEGER PRIMARY KEY, n INTEGER NOT NULL)"
              },
              {
                "params": [
                  {
                    "type": "integer",
                    "value": "7"
                  }
                ],
                "sql": "INSERT INTO events (n) VALUES (?1)"
              },
              {
                "sql": "SELECT n FROM events ORDER BY id"
              }
            ]
          },
          "expected": {
            "results": [
              {
                "rows": [],
                "rowsWritten": 0
              },
              {
                "lastInsertRowId": "1",
                "rows": [],
                "rowsWritten": 1
              },
              {
                "rows": [
                  {
                    "n": {
                      "type": "integer",
                      "value": "7"
                    }
                  }
                ],
                "rowsWritten": 0
              }
            ]
          }
        }
      ]
    },
