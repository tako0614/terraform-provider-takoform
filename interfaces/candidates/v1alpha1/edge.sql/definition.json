        "additionalProperties": false,
        "properties": {
          "results": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "rows": {
                  "items": {
                    "additionalProperties": {
                      "oneOf": [
                        {
                          "type": "null"
                        },
                        {
                          "maximum": 9007199254740991,
                          "minimum": -9007199254740991,
                          "type": "number"
                        },
                        {
                          "maxLength": 1000000,
