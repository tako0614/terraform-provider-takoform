        "additionalProperties": false,
        "properties": {
          "rows": {
            "items": {
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "maximum": 9007199254740991,
                    "minimum": -9007199254740991,
                    "type": "number"
                  },
                  {
                    "maxLength": 1000000,
                    "type": "string"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "data": {
                        "maxLength": 1333336,
                        "type": "string"
                      },
                      "encoding": {
                        "enum": [
                          "base64"
                        ],
                        "type": "string"
                      }
                    },
                    "required": [
                      "data",
                      "encoding"
                    ],
                    "type": "object"
                  }
                ]
              },
              "maxProperties": 100,
              "propertyNames": {
                "maxLength": 128,
                "type": "string"
              },
              "type": "object"
            },
            "maxItems": 10000,
            "type": "array"
          },
          "rowsWritten": {
