    "consistency": "serializable"
  },
  "limits": {
    "maxBlobBytesPerValue": 1000000,
    "maxBoundParameters": 100,
    "maxColumnNameBytes": 128,
    "maxColumnsPerRow": 100,
    "maxResultBytesPerCall": 8388608,
    "maxRowBytes": 2000000,
    "maxRowsPerStatement": 10000,
    "maxStatementBytes": 100000,
    "maxStatementsPerTransaction": 100,
    "maxTextBytesPerValue": 1000000
  },
  "fixtures": [
    {
      "name": "wire-values-round-trip",
      "steps": [
        {
          "operation": "execute",
          "input": {
            "params": [
              1.5,
              "first note",
              {
                "data": "AAECg/8=",
                "encoding": "base64"
              },
              null
            ],
            "sql": "SELECT ?1 AS n, ?2 AS t, ?3 AS b, ?4 AS z"
          },
          "expected": {
            "rows": [
              {
                "b": {
                  "data": "AAECg/8=",
                  "encoding": "base64"
                },
                "n": 1.5,
                "t": "first note",
                "z": null
              }
            ],
            "rowsWritten": 0
          }
        }
      ]
    },
    {
      "name": "safe-number-boundary-round-trips",
      "steps": [
        {
          "operation": "query",
          "input": {
            "params": [
              9007199254740991
            ],
            "sql": "SELECT ?1 AS v"
          },
          "expected": {
            "rows": [
              {
                "v": 9007199254740991
              }
            ],
            "rowsWritten": 0
          }
        }
      ]
    },
    {
      "name": "bound-parameter-result-out-of-range-is-refused",
      "steps": [
        {
          "operation": "query",
          "input": {
            "params": [
              9007199254740991
            ],
            "sql": "SELECT ?1 + 1 AS v"
          },
          "expectedError": "numeric_out_of_range"
        }
      ]
    },
    {
      "name": "out-of-range-output-is-refused",
      "steps": [
        {
          "operation": "query",
          "input": {
            "sql": "SELECT 9007199254740992 AS v"
          },
          "expectedError": "numeric_out_of_range"
        }
      ]
    },
    {
      "name": "a-transaction-reports-one-result-per-statement",
      "steps": [
        {
          "operation": "transaction",
          "input": {
            "statements": [
              {
                "params": [
                  7
                ],
                "sql": "SELECT ?1 AS n"
              },
              {
                "params": [
                  "done"
                ],
                "sql": "SELECT ?1 AS t"
              }
            ]
          },
          "expected": {
            "results": [
              {
                "rows": [
                  {
                    "n": 7
                  }
                ],
                "rowsWritten": 0
              },
              {
                "rows": [
                  {
                    "t": "done"
                  }
                ],
                "rowsWritten": 0
              }
            ]
          }
        }
      ]
    },
    {
      "name": "multiple-statements-are-refused",
      "steps": [
        {
          "operation": "execute",
          "input": {
            "sql": "SELECT 1; SELECT 2"
          },
          "expectedError": "sql_error"
        }
      ]
    },
    {
      "name": "transaction-control-is-refused",
      "steps": [
        {
          "operation": "query",
          "input": {
            "sql": "BEGIN"
          },
          "expectedError": "sql_error"
        }
      ]
    },
    {
      "name": "schema-change-is-admin-only",
      "steps": [
        {
          "operation": "execute",
          "input": {
            "sql": "CREATE TABLE forbidden_runtime_schema (id INTEGER PRIMARY KEY)"
          },
          "expectedError": "sql_error"
        }
      ]
    }
  ]
}
