  "semantics": {
    "consistency": "serializable",
    "delivery": "at_least_once",
    "ordering": "per_key"
  },
  "limits": {
    "maxAlarmLeadSeconds": 31536000,
    "maxBoundParameters": 100,
    "maxRequestBytes": 104857600,
    "maxRequestHeaders": 64,
    "maxResponseBytes": 104857600,
    "maxResponseHeaders": 64,
    "maxRowsPerStatement": 10000,
    "maxStatementBytes": 100000,
    "maxStatementsPerTransaction": 100,
    "maxStorageBytesPerActor": 1073741824
  },
  "fixtures": [
    {
      "name": "a-name-always-derives-one-id",
      "steps": [
        {
          "operation": "idFromName",
          "input": {
            "name": "room-42"
          },
          "expected": {
            "id": "room-42"
          }
        },
        {
          "operation": "idFromName",
          "input": {
            "name": "room-42"
          },
          "expected": {
            "id": "room-42"
          }
        }
      ]
    },
    {
      "name": "the-first-delivery-creates-the-actor",
      "steps": [
        {
          "operation": "idFromName",
          "input": {
            "name": "room-42"
          },
          "expected": {
            "id": "room-42"
          }
        },
        {
          "operation": "fetch",
          "input": {
            "bodyStream": false,
            "contentLength": 0,
            "id": "room-42",
            "method": "GET",
            "path": "/health"
          },
          "expected": {
            "bodyStream": true,
            "status": 200
          }
        }
      ]
    },
    {
      "name": "an-actor-throw-is-a-complete-500",
      "steps": [
        {
          "operation": "fetch",
          "input": {
            "bodyStream": false,
            "contentLength": 0,
            "id": "room-42",
            "method": "GET",
            "path": "/throw"
          },
          "expected": {
            "bodyStream": true,
            "status": 500
          }
        }
      ]
    },
    {
      "name": "no-pending-alarm-is-null-not-zero",
      "steps": [
        {
          "operation": "alarmClear",
          "input": {}
        },
        {
          "operation": "alarmGet",
          "input": {},
          "expected": {
            "atMillis": null
          }
        }
      ]
    }
  ]
}
