    {
      "name": "storageTransaction",
      "description": "Run 1 to 100 statements under serializable all-or-none isolation, materializing every result before commit. A transaction that could report only a write count could not carry the rows a SELECT inside it returned, which would make the atomic path strictly weaker than the plain one.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "statements": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "params": {
                  "items": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "maximum": 9007199254740991,
                        "minimum": -9007199254740991,
                        "type": "number"
                      },
                      {
                        "maxLength": 1000000,
                        "type": "string"
                      },
                      {
                        "additionalProperties": false,
                        "properties": {
                          "data": {
                            "maxLength": 1333336,
                            "type": "string"
                          },
                          "encoding": {
                            "enum": [
