        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "results": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "rows": {
                  "items": {
                    "additionalProperties": {
                      "oneOf": [
                        {
                          "type": "null"
                        },
                        {
                          "maximum": 9007199254740991,
                          "minimum": -9007199254740991,
                          "type": "number"
                        },
                        {
                          "maxLength": 1000000,
                          "type": "string"
                        },
                        {
                          "additionalProperties": false,
                          "properties": {
                            "data": {
                              "maxLength": 1333336,
