                  },
                  {
                    "maximum": 9007199254740991,
                    "minimum": -9007199254740991,
                    "type": "number"
                  },
                  {
                    "maxLength": 1000000,
                    "type": "string"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "data": {
