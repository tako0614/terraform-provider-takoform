{
  "apiVersion": "forms.takoform.com/v1alpha1",
  "kind": "HttpRoute",
  "definitionVersion": "1.0.0",
  "title": "HTTP Route",
  "description": "Portable hostname and path binding that sends HTTP traffic to one connected Resource.",
  "status": "standard",
  "desiredSchema": {
    "$defs": {
      "connection": {
        "additionalProperties": false,
        "properties": {
          "permissions": {
            "items": {
              "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "projection": {
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "resource": {
            "pattern": "^[A-Z][A-Za-z0-9]{0,63}/[a-z][a-z0-9-]{0,62}$",
            "type": "string"
          }
        },
        "required": [
          "permissions",
          "projection",
          "resource"
        ],
        "type": "object"
      },
      "connections": {
        "additionalProperties": {
          "$ref": "#/$defs/connection"
        },
        "maxProperties": 1,
        "minProperties": 1,
        "propertyNames": {
          "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$",
          "type": "string",
          "x-takoform-fieldPolicy": "portable-data-only-v1"
        },
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "connections": {
        "$ref": "#/$defs/connections"
      },
      "hostname": {
        "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+$",
        "type": "string"
      },
      "name": {
        "maxLength": 63,
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9-]{0,62}$",
        "type": "string"
      },
      "pathPrefix": {
        "default": "/",
        "pattern": "^/[A-Za-z0-9._~!$\u0026'()*+,;=:@%/-]*$",
        "type": "string"
      },
      "stripPathPrefix": {
        "type": "boolean"
      }
    },
    "required": [
      "connections",
      "hostname",
      "name"
    ],
    "type": "object"
  },
  "observedSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "driftedFields": {
        "items": {
          "pattern": "^(?:/(?:[^~/]|~0|~1)*)+$",
          "type": "string"
        },
        "type": "array",
        "uniqueItems": true
      },
      "generation": {
        "maximum": 9223372036854775807,
        "minimum": 1,
        "type": "integer"
      },
      "id": {
        "pattern": "^HttpRoute/[a-z][a-z0-9-]{0,62}$",
        "type": "string"
      },
      "imported": {
        "type": "boolean"
      },
      "portability": {
        "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "ready": {
        "type": "boolean"
      }
    },
    "required": [
      "driftedFields",
      "generation",
      "id",
      "imported",
      "portability",
      "ready"
    ],
    "type": "object"
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "generation": {
        "maximum": 9223372036854775807,
        "minimum": 1,
        "type": "integer"
      },
      "id": {
        "pattern": "^HttpRoute/[a-z][a-z0-9-]{0,62}$",
        "type": "string"
      },
      "kind": {
        "const": "HttpRoute",
        "type": "string"
      },
      "name": {
        "maxLength": 63,
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9-]{0,62}$",
        "type": "string"
      },
      "portability": {
        "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      }
    },
    "required": [
      "generation",
      "id",
      "kind",
      "name",
      "portability"
    ],
    "type": "object"
  },
  "immutableFields": [
    "/name"
  ],
  "lifecycleCapabilities": [
    "create",
    "read",
    "update",
    "delete",
    "import",
    "observe",
    "refresh",
    "drift"
  ],
  "conformanceFixtures": [
    {
      "name": "canonical",
      "desiredPath": "fixtures/desired.json",
      "observedPath": "fixtures/observed.json",
      "outputPath": "fixtures/output.json"
    }
  ],
  "negativeConformanceFixtures": [
    {
      "name": "reject-missing-name",
      "stage": "desired",
      "inputPath": "fixtures/negative-missing-name.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-missing-connections",
      "stage": "desired",
      "inputPath": "fixtures/negative-missing-connections.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-missing-hostname",
      "stage": "desired",
      "inputPath": "fixtures/negative-missing-hostname.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-hostname",
      "stage": "desired",
      "inputPath": "fixtures/negative-hostname.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-path_prefix",
      "stage": "desired",
      "inputPath": "fixtures/negative-path_prefix.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-connections-required",
      "stage": "desired",
      "inputPath": "fixtures/negative-connections-required.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-connections-cardinality",
      "stage": "desired",
      "inputPath": "fixtures/negative-connections-cardinality.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-observed-foreign-kind-id",
      "stage": "observed",
      "inputPath": "fixtures/negative-observed-foreign-kind-id.json",
      "expectedFailure": "schema_validation_failed"
    }
  ]
}
