{
  "apiVersion": "forms.takoform.com/v1alpha1",
  "kind": "StaticSite",
  "definitionVersion": "1.0.0",
  "title": "Static Site",
  "description": "Portable static asset site served from a prebuilt immutable artifact.",
  "status": "standard",
  "desiredSchema": {
    "$defs": {
      "artifactSource": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "artifactPath": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "artifactPath"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "artifactSha256": {
                "$ref": "#/$defs/sha256"
              },
              "artifactUrl": {
                "format": "uri",
                "pattern": "^https://",
                "type": "string"
              }
            },
            "required": [
              "artifactSha256",
              "artifactUrl"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "artifactRef": {
                "minLength": 1,
                "type": "string"
              },
              "artifactSha256": {
                "$ref": "#/$defs/sha256"
              }
            },
            "required": [
              "artifactRef",
              "artifactSha256"
            ],
            "type": "object"
          }
        ]
      },
      "sha256": {
        "pattern": "^(sha256:)?[A-Fa-f0-9]{64}$",
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "cacheControlSeconds": {
        "minimum": 0,
        "type": "integer"
      },
      "errorDocument": {
        "minLength": 1,
        "type": "string"
      },
      "indexDocument": {
        "default": "index.html",
        "minLength": 1,
        "type": "string"
      },
      "name": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": ".*\\S.*",
        "type": "string"
      },
      "singlePageApp": {
        "type": "boolean"
      },
      "source": {
        "$ref": "#/$defs/artifactSource"
      }
    },
    "required": [
      "name",
      "source"
    ],
    "type": "object"
  },
  "observedSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "driftedFields": {
        "items": {
          "pattern": "^(?:/(?:[^~/]|~0|~1)*)+$",
          "type": "string"
        },
        "type": "array",
        "uniqueItems": true
      },
      "generation": {
        "minimum": 1,
        "type": "integer"
      },
      "id": {
        "minLength": 1,
        "type": "string"
      },
      "imported": {
        "type": "boolean"
      },
      "portability": {
        "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "ready": {
        "type": "boolean"
      }
    },
    "required": [
      "driftedFields",
      "generation",
      "id",
      "imported",
      "portability",
      "ready"
    ],
    "type": "object"
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "generation": {
        "minimum": 1,
        "type": "integer"
      },
      "id": {
        "minLength": 1,
        "type": "string"
      },
      "kind": {
        "const": "StaticSite",
        "type": "string"
      },
      "name": {
        "minLength": 1,
        "type": "string"
      },
      "portability": {
        "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      }
    },
    "required": [
      "generation",
      "id",
      "kind",
      "name",
      "portability"
    ],
    "type": "object"
  },
  "immutableFields": [
    "/name"
  ],
  "lifecycleCapabilities": [
    "create",
    "read",
    "update",
    "delete",
    "import",
    "observe",
    "refresh",
    "drift"
  ],
  "interfaces": [
    {
      "name": "http.request",
      "version": "1",
      "description": "Portable HTTP request surface exposed by a static site.",
      "required": true,
      "document": {
        "operations": [
          "request"
        ]
      },
      "documentSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "operations": {
            "items": {
              "enum": [
                "request"
              ],
              "type": "string"
            },
            "maxItems": 1,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "operations"
        ],
        "type": "object"
      },
      "inputs": [
        {
          "name": "resource",
          "source": "output",
          "pointer": "/id"
        },
        {
          "name": "name",
          "source": "output",
          "pointer": "/name"
        }
      ]
    }
  ],
  "conformanceFixtures": [
    {
      "name": "canonical",
      "desiredPath": "fixtures/desired.json",
      "observedPath": "fixtures/observed.json",
      "outputPath": "fixtures/output.json"
    }
  ],
  "negativeConformanceFixtures": [
    {
      "name": "reject-cache_control_seconds",
      "stage": "desired",
      "inputPath": "fixtures/negative-cache_control_seconds.json",
      "expectedFailure": "schema_validation_failed"
    }
  ]
}
