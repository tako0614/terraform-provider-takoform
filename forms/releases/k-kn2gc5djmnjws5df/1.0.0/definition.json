{
  "apiVersion": "forms.takoform.com/v1alpha1",
  "kind": "StaticSite",
  "definitionVersion": "1.0.0",
  "title": "Static Site",
  "description": "Portable static asset site served from a prebuilt immutable artifact.",
  "status": "standard",
  "desiredSchema": {
    "$defs": {
      "artifactSource": {
        "additionalProperties": false,
        "properties": {
          "artifactMediaType": {
            "pattern": "^[a-z0-9][a-z0-9!#$\u0026^_.+-]*/[a-z0-9][a-z0-9!#$\u0026^_.+-]*$",
            "type": "string"
          },
          "artifactSha256": {
            "$ref": "#/$defs/sha256"
          },
          "artifactUrl": {
            "format": "uri",
            "pattern": "^https://[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+(?::[0-9]{1,5})?(?:/[^\\s?#]*)?(?:\\?[^\\s#]*)?(?:#[^\\s]*)?$",
            "type": "string"
          }
        },
        "required": [
          "artifactMediaType",
          "artifactSha256",
          "artifactUrl"
        ],
        "type": "object"
      },
      "sha256": {
        "pattern": "^(sha256:)?[A-Fa-f0-9]{64}$",
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "cacheControlSeconds": {
        "minimum": 0,
        "type": "integer"
      },
      "errorDocument": {
        "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*(?:/[A-Za-z0-9_][A-Za-z0-9._-]*)*$",
        "type": "string"
      },
      "indexDocument": {
        "default": "index.html",
        "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*(?:/[A-Za-z0-9_][A-Za-z0-9._-]*)*$",
        "type": "string"
      },
      "name": {
        "maxLength": 63,
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9-]{0,62}$",
        "type": "string"
      },
      "singlePageApp": {
        "type": "boolean"
      },
      "source": {
        "$ref": "#/$defs/artifactSource"
      }
    },
    "required": [
      "name",
      "source"
    ],
    "type": "object"
  },
  "observedSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "driftedFields": {
        "items": {
          "pattern": "^(?:/(?:[^~/]|~0|~1)*)+$",
          "type": "string"
        },
        "type": "array",
        "uniqueItems": true
      },
      "generation": {
        "maximum": 9223372036854775807,
        "minimum": 1,
        "type": "integer"
      },
      "id": {
        "pattern": "^StaticSite/[a-z][a-z0-9-]{0,62}$",
        "type": "string"
      },
      "imported": {
        "type": "boolean"
      },
      "portability": {
        "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "ready": {
        "type": "boolean"
      }
    },
    "required": [
      "driftedFields",
      "generation",
      "id",
      "imported",
      "portability",
      "ready"
    ],
    "type": "object"
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "generation": {
        "maximum": 9223372036854775807,
        "minimum": 1,
        "type": "integer"
      },
      "id": {
        "pattern": "^StaticSite/[a-z][a-z0-9-]{0,62}$",
        "type": "string"
      },
      "kind": {
        "const": "StaticSite",
        "type": "string"
      },
      "name": {
        "maxLength": 63,
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9-]{0,62}$",
        "type": "string"
      },
      "portability": {
        "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      }
    },
    "required": [
      "generation",
      "id",
      "kind",
      "name",
      "portability"
    ],
    "type": "object"
  },
  "immutableFields": [
    "/name"
  ],
  "lifecycleCapabilities": [
    "create",
    "read",
    "update",
    "delete",
    "import",
    "observe",
    "refresh",
    "drift"
  ],
  "interfaces": [
    {
      "name": "http.request",
      "version": "1",
      "description": "Portable HTTP request surface exposed by a static site.",
      "required": true,
      "document": {
        "operations": [
          "request"
        ]
      },
      "documentSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "operations": {
            "items": {
              "enum": [
                "request"
              ],
              "type": "string"
            },
            "maxItems": 1,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "operations"
        ],
        "type": "object"
      },
      "inputs": [
        {
          "name": "resource",
          "source": "output",
          "pointer": "/id"
        },
        {
          "name": "name",
          "source": "output",
          "pointer": "/name"
        }
      ]
    }
  ],
  "conformanceFixtures": [
    {
      "name": "canonical",
      "desiredPath": "fixtures/desired.json",
      "observedPath": "fixtures/observed.json",
      "outputPath": "fixtures/output.json"
    }
  ],
  "negativeConformanceFixtures": [
    {
      "name": "reject-missing-name",
      "stage": "desired",
      "inputPath": "fixtures/negative-missing-name.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-missing-source",
      "stage": "desired",
      "inputPath": "fixtures/negative-missing-source.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-index_document",
      "stage": "desired",
      "inputPath": "fixtures/negative-index_document.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-error_document",
      "stage": "desired",
      "inputPath": "fixtures/negative-error_document.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-cache_control_seconds",
      "stage": "desired",
      "inputPath": "fixtures/negative-cache_control_seconds.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-artifact-source",
      "stage": "desired",
      "inputPath": "fixtures/negative-artifact-source.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-observed-foreign-kind-id",
      "stage": "observed",
      "inputPath": "fixtures/negative-observed-foreign-kind-id.json",
      "expectedFailure": "schema_validation_failed"
    }
  ]
}
