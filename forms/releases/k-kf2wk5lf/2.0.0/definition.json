{
  "apiVersion": "forms.takoform.com/v1alpha1",
  "kind": "Queue",
  "definitionVersion": "2.0.0",
  "title": "Queue",
  "description": "Portable asynchronous delivery with at-least-once semantics.",
  "status": "standard",
  "desiredSchema": {
    "$defs": {
      "connection": {
        "additionalProperties": false,
        "properties": {
          "permissions": {
            "items": {
              "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "projection": {
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "resource": {
            "pattern": "^\\S+$",
            "type": "string"
          }
        },
        "required": [
          "permissions",
          "projection",
          "resource"
        ],
        "type": "object"
      },
      "connections": {
        "additionalProperties": {
          "$ref": "#/$defs/connection"
        },
        "propertyNames": {
          "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$",
          "type": "string",
          "x-takoform-fieldPolicy": "portable-data-only-v1"
        },
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "connections": {
        "$ref": "#/$defs/connections"
      },
      "deliveryDelaySeconds": {
        "minimum": 0,
        "type": "integer"
      },
      "maxBatchSize": {
        "minimum": 1,
        "type": "integer"
      },
      "maxMessageBytes": {
        "minimum": 1,
        "type": "integer"
      },
      "maxRetries": {
        "minimum": 0,
        "type": "integer"
      },
      "messageRetentionSeconds": {
        "minimum": 1,
        "type": "integer"
      },
      "name": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": ".*\\S.*",
        "type": "string"
      },
      "ordering": {
        "enum": [
          "best_effort",
          "strict"
        ],
        "type": "string"
      },
      "visibilityTimeoutSeconds": {
        "minimum": 0,
        "type": "integer"
      }
    },
    "required": [
      "name"
    ],
    "type": "object"
  },
  "observedSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "driftedFields": {
        "items": {
          "pattern": "^(?:/(?:[^~/]|~0|~1)*)+$",
          "type": "string"
        },
        "type": "array",
        "uniqueItems": true
      },
      "generation": {
        "minimum": 1,
        "type": "integer"
      },
      "id": {
        "minLength": 1,
        "type": "string"
      },
      "imported": {
        "type": "boolean"
      },
      "portability": {
        "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "ready": {
        "type": "boolean"
      }
    },
    "required": [
      "driftedFields",
      "generation",
      "id",
      "imported",
      "portability",
      "ready"
    ],
    "type": "object"
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "generation": {
        "minimum": 1,
        "type": "integer"
      },
      "id": {
        "minLength": 1,
        "type": "string"
      },
      "kind": {
        "const": "Queue",
        "type": "string"
      },
      "name": {
        "minLength": 1,
        "type": "string"
      },
      "portability": {
        "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      }
    },
    "required": [
      "generation",
      "id",
      "kind",
      "name",
      "portability"
    ],
    "type": "object"
  },
  "immutableFields": [
    "/name"
  ],
  "lifecycleCapabilities": [
    "create",
    "read",
    "update",
    "delete",
    "import",
    "observe",
    "refresh",
    "drift"
  ],
  "interfaces": [
    {
      "name": "queue.messages",
      "version": "1",
      "description": "Portable queue delivery operations.",
      "required": true,
      "document": {
        "operations": [
          "acknowledge",
          "receive",
          "send"
        ]
      },
      "documentSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "operations": {
            "items": {
              "enum": [
                "acknowledge",
                "receive",
                "send"
              ],
              "type": "string"
            },
            "maxItems": 3,
            "minItems": 3,
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "operations"
        ],
        "type": "object"
      },
      "inputs": [
        {
          "name": "resource",
          "source": "output",
          "pointer": "/id"
        },
        {
          "name": "name",
          "source": "output",
          "pointer": "/name"
        }
      ]
    }
  ],
  "conformanceFixtures": [
    {
      "name": "canonical",
      "desiredPath": "fixtures/desired.json",
      "observedPath": "fixtures/observed.json",
      "outputPath": "fixtures/output.json"
    }
  ],
  "negativeConformanceFixtures": [
    {
      "name": "reject-max_retries",
      "stage": "desired",
      "inputPath": "fixtures/negative-max_retries.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-max_batch_size",
      "stage": "desired",
      "inputPath": "fixtures/negative-max_batch_size.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-visibility_timeout_seconds",
      "stage": "desired",
      "inputPath": "fixtures/negative-visibility_timeout_seconds.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-message_retention_seconds",
      "stage": "desired",
      "inputPath": "fixtures/negative-message_retention_seconds.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-max_message_bytes",
      "stage": "desired",
      "inputPath": "fixtures/negative-max_message_bytes.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-delivery_delay_seconds",
      "stage": "desired",
      "inputPath": "fixtures/negative-delivery_delay_seconds.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-ordering",
      "stage": "desired",
      "inputPath": "fixtures/negative-ordering.json",
      "expectedFailure": "schema_validation_failed"
    }
  ]
}
