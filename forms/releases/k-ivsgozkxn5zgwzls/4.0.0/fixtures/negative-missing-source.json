{
  "assetsNotFoundHandling": "single_page_application",
  "assetsPath": "assets",
  "concurrency": 100,
  "configuration": {
    "LOG_LEVEL": "info"
  },
  "connections": {
    "assets": {
      "permissions": [
        "read"
      ],
      "projection": "object.binding.v1",
      "resource": "ObjectBucket/object-bucket"
    }
  },
  "entrypoint": "worker.mjs",
  "name": "edge-worker",
  "requestTimeoutSeconds": 30,
  "runtime": "javascript",
  "runtimeVersion": "2026.1"
}
