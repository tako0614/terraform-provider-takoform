{
  "apiVersion": "forms.takoform.com/v1alpha1",
  "kind": "IdentityClient",
  "definitionVersion": "1.0.0",
  "title": "Identity Client",
  "description": "Portable OIDC relying-party registration. Issued client material stays with the host.",
  "status": "standard",
  "desiredSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "authMethod": {
        "default": "none",
        "enum": [
          "none",
          "client_secret_basic",
          "private_key_jwt"
        ],
        "type": "string"
      },
      "name": {
        "maxLength": 63,
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9-]{0,62}$",
        "type": "string"
      },
      "redirectUris": {
        "items": {
          "format": "uri",
          "pattern": "^https://[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+(?::[0-9]{1,5})?(?:/[^\\s?#]*)?(?:\\?[^\\s#]*)?(?:#[^\\s]*)?$",
          "type": "string"
        },
        "minItems": 1,
        "type": "array",
        "uniqueItems": true
      }
    },
    "required": [
      "name",
      "redirectUris"
    ],
    "type": "object"
  },
  "observedSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "driftedFields": {
        "items": {
          "pattern": "^(?:/(?:[^~/]|~0|~1)*)+$",
          "type": "string"
        },
        "type": "array",
        "uniqueItems": true
      },
      "generation": {
        "maximum": 9223372036854775807,
        "minimum": 1,
        "type": "integer"
      },
      "id": {
        "pattern": "^IdentityClient/[a-z][a-z0-9-]{0,62}$",
        "type": "string"
      },
      "imported": {
        "type": "boolean"
      },
      "portability": {
        "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "ready": {
        "type": "boolean"
      }
    },
    "required": [
      "driftedFields",
      "generation",
      "id",
      "imported",
      "portability",
      "ready"
    ],
    "type": "object"
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "generation": {
        "maximum": 9223372036854775807,
        "minimum": 1,
        "type": "integer"
      },
      "id": {
        "pattern": "^IdentityClient/[a-z][a-z0-9-]{0,62}$",
        "type": "string"
      },
      "kind": {
        "const": "IdentityClient",
        "type": "string"
      },
      "name": {
        "maxLength": 63,
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9-]{0,62}$",
        "type": "string"
      },
      "portability": {
        "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      }
    },
    "required": [
      "generation",
      "id",
      "kind",
      "name",
      "portability"
    ],
    "type": "object"
  },
  "immutableFields": [
    "/name"
  ],
  "lifecycleCapabilities": [
    "create",
    "read",
    "update",
    "delete",
    "import",
    "observe",
    "refresh",
    "drift"
  ],
  "interfaces": [
    {
      "name": "identity.oidc",
      "version": "1",
      "description": "Portable OIDC relying-party metadata operations.",
      "required": true,
      "document": {
        "operations": [
          "metadata"
        ]
      },
      "documentSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "operations": {
            "items": {
              "enum": [
                "metadata"
              ],
              "type": "string"
            },
            "maxItems": 1,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "operations"
        ],
        "type": "object"
      },
      "inputs": [
        {
          "name": "resource",
          "source": "output",
          "pointer": "/id"
        },
        {
          "name": "name",
          "source": "output",
          "pointer": "/name"
        }
      ]
    }
  ],
  "conformanceFixtures": [
    {
      "name": "canonical",
      "desiredPath": "fixtures/desired.json",
      "observedPath": "fixtures/observed.json",
      "outputPath": "fixtures/output.json"
    }
  ],
  "negativeConformanceFixtures": [
    {
      "name": "reject-missing-name",
      "stage": "desired",
      "inputPath": "fixtures/negative-missing-name.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-missing-redirect_uris",
      "stage": "desired",
      "inputPath": "fixtures/negative-missing-redirect_uris.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-redirect_uris",
      "stage": "desired",
      "inputPath": "fixtures/negative-redirect_uris.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-auth_method",
      "stage": "desired",
      "inputPath": "fixtures/negative-auth_method.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-observed-foreign-kind-id",
      "stage": "observed",
      "inputPath": "fixtures/negative-observed-foreign-kind-id.json",
      "expectedFailure": "schema_validation_failed"
    }
  ]
}
