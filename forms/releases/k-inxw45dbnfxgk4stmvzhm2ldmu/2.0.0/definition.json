{
  "apiVersion": "forms.takoform.com/v1alpha1",
  "kind": "ContainerService",
  "definitionVersion": "2.0.0",
  "title": "Container Service",
  "description": "Portable OCI container service pinned to an immutable image digest.",
  "status": "standard",
  "desiredSchema": {
    "$defs": {
      "connection": {
        "additionalProperties": false,
        "properties": {
          "permissions": {
            "items": {
              "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "projection": {
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "resource": {
            "pattern": "^\\S+$",
            "type": "string"
          }
        },
        "required": [
          "permissions",
          "projection",
          "resource"
        ],
        "type": "object"
      },
      "connections": {
        "additionalProperties": {
          "$ref": "#/$defs/connection"
        },
        "propertyNames": {
          "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$",
          "type": "string",
          "x-takoform-fieldPolicy": "portable-data-only-v1"
        },
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "configuration": {
        "additionalProperties": {
          "maxLength": 4096,
          "type": "string"
        },
        "propertyNames": {
          "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$",
          "type": "string",
          "x-takoform-fieldPolicy": "portable-data-only-v1"
        },
        "type": "object"
      },
      "connections": {
        "$ref": "#/$defs/connections"
      },
      "cpuMillicores": {
        "minimum": 1,
        "type": "integer"
      },
      "healthCheckPath": {
        "pattern": "^/[A-Za-z0-9._~!$\u0026'()*+,;=:@%/-]*$",
        "type": "string"
      },
      "image": {
        "pattern": "^[^@\\s]+@sha256:[A-Fa-f0-9]{64}$",
        "type": "string"
      },
      "memoryMib": {
        "minimum": 1,
        "type": "integer"
      },
      "name": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": ".*\\S.*",
        "type": "string"
      },
      "ports": {
        "items": {
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        },
        "type": "array",
        "uniqueItems": true
      },
      "publicHttp": {
        "type": "boolean"
      },
      "replicas": {
        "minimum": 1,
        "type": "integer"
      }
    },
    "required": [
      "image",
      "name"
    ],
    "type": "object"
  },
  "observedSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "driftedFields": {
        "items": {
          "pattern": "^(?:/(?:[^~/]|~0|~1)*)+$",
          "type": "string"
        },
        "type": "array",
        "uniqueItems": true
      },
      "generation": {
        "minimum": 1,
        "type": "integer"
      },
      "id": {
        "minLength": 1,
        "type": "string"
      },
      "imported": {
        "type": "boolean"
      },
      "portability": {
        "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "ready": {
        "type": "boolean"
      }
    },
    "required": [
      "driftedFields",
      "generation",
      "id",
      "imported",
      "portability",
      "ready"
    ],
    "type": "object"
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "generation": {
        "minimum": 1,
        "type": "integer"
      },
      "id": {
        "minLength": 1,
        "type": "string"
      },
      "kind": {
        "const": "ContainerService",
        "type": "string"
      },
      "name": {
        "minLength": 1,
        "type": "string"
      },
      "portability": {
        "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      }
    },
    "required": [
      "generation",
      "id",
      "kind",
      "name",
      "portability"
    ],
    "type": "object"
  },
  "immutableFields": [
    "/name"
  ],
  "lifecycleCapabilities": [
    "create",
    "read",
    "update",
    "delete",
    "import",
    "observe",
    "refresh",
    "drift"
  ],
  "interfaces": [
    {
      "name": "http.request",
      "version": "1",
      "description": "Portable HTTP request surface exposed by a container service.",
      "required": true,
      "document": {
        "operations": [
          "request"
        ]
      },
      "documentSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "operations": {
            "items": {
              "enum": [
                "request"
              ],
              "type": "string"
            },
            "maxItems": 1,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "operations"
        ],
        "type": "object"
      },
      "inputs": [
        {
          "name": "resource",
          "source": "output",
          "pointer": "/id"
        },
        {
          "name": "name",
          "source": "output",
          "pointer": "/name"
        }
      ]
    }
  ],
  "conformanceFixtures": [
    {
      "name": "canonical",
      "desiredPath": "fixtures/desired.json",
      "observedPath": "fixtures/observed.json",
      "outputPath": "fixtures/output.json"
    }
  ],
  "negativeConformanceFixtures": [
    {
      "name": "reject-image",
      "stage": "desired",
      "inputPath": "fixtures/negative-image.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-ports",
      "stage": "desired",
      "inputPath": "fixtures/negative-ports.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-cpu_millicores",
      "stage": "desired",
      "inputPath": "fixtures/negative-cpu_millicores.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-memory_mib",
      "stage": "desired",
      "inputPath": "fixtures/negative-memory_mib.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-replicas",
      "stage": "desired",
      "inputPath": "fixtures/negative-replicas.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-health_check_path",
      "stage": "desired",
      "inputPath": "fixtures/negative-health_check_path.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-configuration",
      "stage": "desired",
      "inputPath": "fixtures/negative-configuration.json",
      "expectedFailure": "schema_validation_failed"
    }
  ]
}
