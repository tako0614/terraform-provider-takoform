{
  "apiVersion": "forms.takoform.com/v1alpha1",
  "kind": "LogSink",
  "definitionVersion": "1.0.0",
  "title": "Log Sink",
  "description": "Portable destination that retains structured application logs.",
  "status": "standard",
  "desiredSchema": {
    "$defs": {
      "connection": {
        "additionalProperties": false,
        "properties": {
          "permissions": {
            "items": {
              "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "projection": {
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "resource": {
            "pattern": "^\\S+$",
            "type": "string"
          }
        },
        "required": [
          "permissions",
          "projection",
          "resource"
        ],
        "type": "object"
      },
      "connections": {
        "additionalProperties": {
          "$ref": "#/$defs/connection"
        },
        "propertyNames": {
          "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$",
          "type": "string",
          "x-takoform-fieldPolicy": "portable-data-only-v1"
        },
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "connections": {
        "$ref": "#/$defs/connections"
      },
      "format": {
        "default": "json",
        "enum": [
          "json",
          "text"
        ],
        "type": "string"
      },
      "name": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": ".*\\S.*",
        "type": "string"
      },
      "retentionDays": {
        "minimum": 1,
        "type": "integer"
      }
    },
    "required": [
      "name"
    ],
    "type": "object"
  },
  "observedSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "driftedFields": {
        "items": {
          "pattern": "^(?:/(?:[^~/]|~0|~1)*)+$",
          "type": "string"
        },
        "type": "array",
        "uniqueItems": true
      },
      "generation": {
        "minimum": 1,
        "type": "integer"
      },
      "id": {
        "minLength": 1,
        "type": "string"
      },
      "imported": {
        "type": "boolean"
      },
      "portability": {
        "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "ready": {
        "type": "boolean"
      }
    },
    "required": [
      "driftedFields",
      "generation",
      "id",
      "imported",
      "portability",
      "ready"
    ],
    "type": "object"
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "generation": {
        "minimum": 1,
        "type": "integer"
      },
      "id": {
        "minLength": 1,
        "type": "string"
      },
      "kind": {
        "const": "LogSink",
        "type": "string"
      },
      "name": {
        "minLength": 1,
        "type": "string"
      },
      "portability": {
        "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      }
    },
    "required": [
      "generation",
      "id",
      "kind",
      "name",
      "portability"
    ],
    "type": "object"
  },
  "immutableFields": [
    "/name"
  ],
  "lifecycleCapabilities": [
    "create",
    "read",
    "update",
    "delete",
    "import",
    "observe",
    "refresh",
    "drift"
  ],
  "interfaces": [
    {
      "name": "log.ingest",
      "version": "1",
      "description": "Portable log ingest and read operations.",
      "required": true,
      "document": {
        "operations": [
          "query",
          "write"
        ]
      },
      "documentSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "operations": {
            "items": {
              "enum": [
                "query",
                "write"
              ],
              "type": "string"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "operations"
        ],
        "type": "object"
      },
      "inputs": [
        {
          "name": "resource",
          "source": "output",
          "pointer": "/id"
        },
        {
          "name": "name",
          "source": "output",
          "pointer": "/name"
        }
      ]
    }
  ],
  "conformanceFixtures": [
    {
      "name": "canonical",
      "desiredPath": "fixtures/desired.json",
      "observedPath": "fixtures/observed.json",
      "outputPath": "fixtures/output.json"
    }
  ],
  "negativeConformanceFixtures": [
    {
      "name": "reject-invalid-semantics",
      "stage": "desired",
      "inputPath": "fixtures/negative.json",
      "expectedFailure": "schema_validation_failed"
    }
  ]
}
