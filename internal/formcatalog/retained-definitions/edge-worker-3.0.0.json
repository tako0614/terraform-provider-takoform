{
  "apiVersion": "forms.takoform.com/v1alpha1",
  "kind": "EdgeWorker",
  "definitionVersion": "3.0.0",
  "title": "Edge Worker",
  "description": "Portable edge/event-driven application served from a prebuilt immutable artifact.",
  "status": "standard",
  "desiredSchema": {
    "$defs": {
      "artifactSource": {
        "additionalProperties": false,
        "properties": {
          "artifactMediaType": {
            "pattern": "^[a-z0-9][a-z0-9!#$\u0026^_.+-]*/[a-z0-9][a-z0-9!#$\u0026^_.+-]*$",
            "type": "string"
          },
          "artifactSha256": {
            "$ref": "#/$defs/sha256"
          },
          "artifactUrl": {
            "format": "uri",
            "pattern": "^https://[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+(?::[0-9]{1,5})?(?:/[^\\s?#]*)?$",
            "type": "string"
          }
        },
        "required": [
          "artifactMediaType",
          "artifactSha256",
          "artifactUrl"
        ],
        "type": "object"
      },
      "connection": {
        "additionalProperties": false,
        "properties": {
          "permissions": {
            "items": {
              "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "projection": {
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "resource": {
            "pattern": "^[A-Z][A-Za-z0-9]{0,63}/[a-z][a-z0-9-]{0,62}$",
            "type": "string"
          }
        },
        "required": [
          "permissions",
          "projection",
          "resource"
        ],
        "type": "object"
      },
      "connections": {
        "additionalProperties": {
          "$ref": "#/$defs/connection"
        },
        "propertyNames": {
          "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$",
          "type": "string",
          "x-takoform-fieldPolicy": "portable-data-only-v1"
        },
        "type": "object"
      },
      "sha256": {
        "pattern": "^(sha256:)?[A-Fa-f0-9]{64}$",
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "concurrency": {
        "minimum": 1,
        "type": "integer"
      },
      "configuration": {
        "additionalProperties": {
          "maxLength": 4096,
          "type": "string"
        },
        "propertyNames": {
          "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$",
          "type": "string",
          "x-takoform-fieldPolicy": "portable-data-only-v1"
        },
        "type": "object"
      },
      "connections": {
        "$ref": "#/$defs/connections"
      },
      "entrypoint": {
        "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*(?:/[A-Za-z0-9_][A-Za-z0-9._-]*)*$",
        "type": "string"
      },
      "name": {
        "maxLength": 63,
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9-]{0,62}$",
        "type": "string"
      },
      "requestTimeoutSeconds": {
        "maximum": 3600,
        "minimum": 1,
        "type": "integer"
      },
      "runtime": {
        "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "runtimeVersion": {
        "pattern": "^[0-9A-Za-z][0-9A-Za-z._+-]{0,63}$",
        "type": "string"
      },
      "source": {
        "$ref": "#/$defs/artifactSource"
      }
    },
    "required": [
      "entrypoint",
      "name",
      "source"
    ],
    "type": "object"
  },
  "observedSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "driftedFields": {
        "items": {
          "pattern": "^(?:/(?:[^~/]|~0|~1)*)+$",
          "type": "string"
        },
        "type": "array",
        "uniqueItems": true
      },
      "generation": {
        "maximum": 9223372036854775807,
        "minimum": 1,
        "type": "integer"
      },
      "id": {
        "pattern": "^EdgeWorker/[a-z][a-z0-9-]{0,62}$",
        "type": "string"
      },
      "imported": {
        "type": "boolean"
      },
      "portability": {
        "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "ready": {
        "type": "boolean"
      }
    },
    "required": [
      "driftedFields",
      "generation",
      "id",
      "imported",
      "portability",
      "ready"
    ],
    "type": "object"
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "generation": {
        "maximum": 9223372036854775807,
        "minimum": 1,
        "type": "integer"
      },
      "id": {
        "pattern": "^EdgeWorker/[a-z][a-z0-9-]{0,62}$",
        "type": "string"
      },
      "kind": {
        "const": "EdgeWorker",
        "type": "string"
      },
      "name": {
        "maxLength": 63,
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9-]{0,62}$",
        "type": "string"
      },
      "portability": {
        "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      }
    },
    "required": [
      "generation",
      "id",
      "kind",
      "name",
      "portability"
    ],
    "type": "object"
  },
  "immutableFields": [
    "/name"
  ],
  "lifecycleCapabilities": [
    "create",
    "read",
    "update",
    "delete",
    "import",
    "observe",
    "refresh",
    "drift"
  ],
  "interfaces": [
    {
      "name": "http.request",
      "version": "1",
      "description": "Portable HTTP request surface exposed by an edge application.",
      "required": true,
      "document": {
        "operations": [
          "request"
        ]
      },
      "documentSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "operations": {
            "items": {
              "enum": [
                "request"
              ],
              "type": "string"
            },
            "maxItems": 1,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "operations"
        ],
        "type": "object"
      },
      "inputs": [
        {
          "name": "resource",
          "source": "output",
          "pointer": "/id"
        },
        {
          "name": "name",
          "source": "output",
          "pointer": "/name"
        }
      ]
    }
  ],
  "conformanceFixtures": [
    {
      "name": "canonical",
      "desiredPath": "fixtures/desired.json",
      "observedPath": "fixtures/observed.json",
      "outputPath": "fixtures/output.json"
    }
  ],
  "negativeConformanceFixtures": [
    {
      "name": "reject-missing-name",
      "stage": "desired",
      "inputPath": "fixtures/negative-missing-name.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-missing-source",
      "stage": "desired",
      "inputPath": "fixtures/negative-missing-source.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-missing-entrypoint",
      "stage": "desired",
      "inputPath": "fixtures/negative-missing-entrypoint.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-entrypoint",
      "stage": "desired",
      "inputPath": "fixtures/negative-entrypoint.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-runtime",
      "stage": "desired",
      "inputPath": "fixtures/negative-runtime.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-runtime_version",
      "stage": "desired",
      "inputPath": "fixtures/negative-runtime_version.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-request_timeout_seconds",
      "stage": "desired",
      "inputPath": "fixtures/negative-request_timeout_seconds.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-concurrency",
      "stage": "desired",
      "inputPath": "fixtures/negative-concurrency.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-configuration",
      "stage": "desired",
      "inputPath": "fixtures/negative-configuration.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-artifact-url-userinfo",
      "stage": "desired",
      "inputPath": "fixtures/negative-artifact-url-userinfo.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-artifact-url-query",
      "stage": "desired",
      "inputPath": "fixtures/negative-artifact-url-query.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-artifact-url-fragment",
      "stage": "desired",
      "inputPath": "fixtures/negative-artifact-url-fragment.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-artifact-source",
      "stage": "desired",
      "inputPath": "fixtures/negative-artifact-source.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-observed-foreign-kind-id",
      "stage": "observed",
      "inputPath": "fixtures/negative-observed-foreign-kind-id.json",
      "expectedFailure": "schema_validation_failed"
    }
  ]
}
