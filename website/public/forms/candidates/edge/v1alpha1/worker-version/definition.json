    "additionalProperties": false,
    "description": "Immutable executable snapshot of one Module Worker: a bundle, a runtime compatibility date, declared handlers, non-secret vars, and the typed capability bindings the code may use. A change is a new Worker Version; traffic moves only through Worker Deployments.",
    "properties": {
      "bucketBindings": {
        "default": [],
        "description": "Typed module-worker.object-bucket bindings projecting the edge.objects API. Omitting it declares no such binding.",
        "items": {
          "additionalProperties": false,
          "properties": {
            "name": {
              "maxLength": 64,
              "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$",
              "type": "string"
            },
            "resource": {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "ObjectBucket",
                  "type": "string"
                },
                "name": {
                  "maxLength": 63,
                  "minLength": 1,
                  "pattern": "^[a-z][a-z0-9-]{0,62}$",
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "name"
              ],
              "type": "object"
            }
          },
          "required": [
            "name",
            "resource"
          ],
          "type": "object"
        },
        "maxItems": 64,
        "type": "array",
        "uniqueItems": true
      },
      "bundle": {
        "additionalProperties": false,
        "description": "Worker Bundle carrying the exact module bytes this version executes.",
        "properties": {
          "kind": {
            "const": "WorkerBundle",
            "type": "string"
          },
          "name": {
            "maxLength": 63,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9-]{0,62}$",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "name"
        ],
        "type": "object"
      },
      "compatibilityDate": {
        "description": "Runtime compatibility date fixing default runtime behavior for this version.",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "type": "string"
      },
      "compatibilityFlags": {
        "default": [],
        "description": "Closed runtime compatibility flags enabled for this version. Omitting it enables no flag.",
        "items": {
          "enum": [
            "nodejs_compat"
          ],
          "type": "string"
        },
        "type": "array",
        "uniqueItems": true
      },
      "handlers": {
        "description": "Module event handlers this version exports. A host rejects an attachment whose event kind is not declared here.",
        "items": {
          "enum": [
            "fetch",
            "scheduled",
            "queue",
            "tail"
          ],
          "type": "string"
        },
        "minItems": 1,
        "type": "array",
        "uniqueItems": true
      },
      "kvBindings": {
        "default": [],
