{
  "apiVersion": "edge.forms.takoform.com/v1alpha1",
  "kind": "QueueConsumer",
  "definitionVersion": "0.1.0",
  "title": "Queue Consumer",
  "description": "Attaches one Module Worker as the batch consumer of one At-Least-Once Queue, invoking its queue handler with message batches and redelivering failed batches. Consumption is inward activation and therefore an attachment, never a binding.",
  "role": "attachment",
  "desiredSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Attaches one Module Worker as the batch consumer of one At-Least-Once Queue, invoking its queue handler with message batches and redelivering failed batches. Consumption is inward activation and therefore an attachment, never a binding.",
    "properties": {
      "deadLetterQueue": {
        "additionalProperties": false,
        "description": "Queue receiving messages that exhausted their retries. Without it, exhausted messages are dropped.",
        "properties": {
          "kind": {
            "const": "AtLeastOnceQueue",
            "type": "string"
          },
          "name": {
            "maxLength": 63,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9-]{0,62}$",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "name"
        ],
        "type": "object"
      },
      "maxBatchSize": {
        "description": "Largest number of messages delivered in one batch.",
        "maximum": 100,
        "minimum": 1,
        "type": "integer"
      },
      "maxBatchTimeoutSeconds": {
        "description": "Longest time the host waits to fill a batch before delivering it, in seconds.",
        "maximum": 60,
        "minimum": 0,
        "type": "integer"
      },
      "maxConcurrency": {
        "description": "Largest number of concurrent batch invocations.",
        "maximum": 250,
        "minimum": 1,
        "type": "integer"
      },
      "maxRetries": {
        "description": "How many times a failed batch is redelivered before its messages go to the dead-letter queue or are dropped.",
        "maximum": 100,
        "minimum": 0,
        "type": "integer"
      },
      "queue": {
        "additionalProperties": false,
        "description": "Queue this consumer drains. Changing it replaces the attachment.",
        "properties": {
          "kind": {
            "const": "AtLeastOnceQueue",
            "type": "string"
          },
          "name": {
            "maxLength": 63,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9-]{0,62}$",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "name"
        ],
        "type": "object"
      },
      "retryDelaySeconds": {
        "description": "Delay before a failed batch becomes deliverable again, in seconds.",
        "maximum": 43200,
        "minimum": 0,
        "type": "integer"
      },
      "worker": {
        "additionalProperties": false,
        "description": "Module Worker whose queue handler receives the batches. Changing it replaces the attachment.",
        "properties": {
          "kind": {
            "const": "ModuleWorker",
            "type": "string"
          },
          "name": {
            "maxLength": 63,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9-]{0,62}$",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "name"
        ],
        "type": "object"
      }
    },
    "required": [
      "queue",
      "worker"
    ],
    "title": "Queue Consumer desired state",
    "type": "object"
  },
  "immutableFields": [
    "/queue",
    "/worker"
  ],
  "lifecycleCapabilities": [
    "create",
    "read",
    "update",
    "delete",
    "import",
    "observe",
    "refresh"
  ],
  "conformanceFixtures": [
    {
      "name": "canonical",
      "desiredPath": "fixtures/desired.json"
    }
  ],
  "negativeConformanceFixtures": [
    {
      "name": "reject-unexpected-property",
      "stage": "desired",
      "inputPath": "fixtures/negative-unexpected-property.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-missing-queue",
      "stage": "desired",
      "inputPath": "fixtures/negative-missing-queue.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-missing-worker",
      "stage": "desired",
      "inputPath": "fixtures/negative-missing-worker.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-queue",
      "stage": "desired",
      "inputPath": "fixtures/negative-queue.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-worker",
      "stage": "desired",
      "inputPath": "fixtures/negative-worker.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-max-batch-size",
      "stage": "desired",
      "inputPath": "fixtures/negative-max-batch-size.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-max-batch-timeout-seconds",
      "stage": "desired",
      "inputPath": "fixtures/negative-max-batch-timeout-seconds.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-max-retries",
      "stage": "desired",
      "inputPath": "fixtures/negative-max-retries.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-retry-delay-seconds",
      "stage": "desired",
      "inputPath": "fixtures/negative-retry-delay-seconds.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-dead-letter-queue",
      "stage": "desired",
      "inputPath": "fixtures/negative-dead-letter-queue.json",
      "expectedFailure": "schema_validation_failed"
    },
    {
      "name": "reject-max-concurrency",
      "stage": "desired",
      "inputPath": "fixtures/negative-max-concurrency.json",
      "expectedFailure": "schema_validation_failed"
    }
  ]
}
