    "description": "Message queue with at-least-once delivery and no ordering guarantee, exactly as fixed by the edge.queue Interface. There is no ordering field: a FIFO queue is a different Form.",
    "properties": {
      "deliveryDelaySeconds": {
        "description": "Default delay before a sent message becomes deliverable, in seconds.",
        "maximum": 43200,
        "minimum": 0,
        "type": "integer"
      },
      "messageRetentionSeconds": {
        "description": "How long an undelivered message is retained before it is dropped, in seconds.",
        "maximum": 1209600,
        "minimum": 60,
        "type": "integer"
      }
    },
