{
  "bucketBindings": [
    {
      "name": "MEDIA",
      "resource": {
        "kind": "ObjectBucket",
        "name": "object-bucket"
      }
    }
  ],
  "bundle": {
    "kind": "WorkerBundle",
    "name": "worker-bundle"
  },
  "compatibilityDate": "2026-08-06",
  "compatibilityFlags": [
    "nodejs_compat"
  ],
  "handlers": [
    "fetch"
  ],
  "kvBindings": [
    {
      "name": "CACHE",
      "resource": {
        "kind": "EdgeKVNamespace",
        "name": "edge-kv-namespace"
      }
    }
  ],
  "queueProducerBindings": [
    {
      "name": "1binding",
      "resource": {
        "kind": "AtLeastOnceQueue",
        "name": "example-target"
      }
    }
  ],
  "requiredSensitiveVars": [
    "API_SIGNING_TOKEN_NAME"
  ],
  "serviceBindings": [
    {
      "name": "AUTH",
      "resource": {
        "kind": "ModuleWorker",
        "name": "auth-worker"
      }
    }
  ],
  "sqliteBindings": [
    {
      "name": "DB",
      "resource": {
        "kind": "SQLiteDatabase",
        "name": "sqlite-database"
      }
    }
  ],
  "vars": {
    "LOG_LEVEL": "info"
  },
  "worker": {
    "kind": "ModuleWorker",
    "name": "module-worker"
  }
}
